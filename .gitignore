__pycache__/
*.pyc
.env
venv/
.venv/
# Everything a session writes, whatever the format: v0.7.5 added .json, and a
# per-extension list would have published it on the first `git add -A`.
reports/*
!reports/.gitkeep
.ruff_cache/
.pytest_cache/
config/targets.yaml
# Ignore the contents, keep the folder's README. `state/` alone would stop
# git descending into the directory at all, so the negation below would
# never be reached.
state/*
!state/README.md
# Generated wordlists name a target's paths and hostnames (v0.10.0).
wordlists/generated/
# Packaging output (v0.10.0).
build/
dist/
*.egg-info/
# Logs copied off a target for the hunt agent. They are the target's data,
# not this project's; a live run worth keeping is copied into
# tests/fixtures/ deliberately (v1.0.0 kept logs/lab131 that way).
logs/
