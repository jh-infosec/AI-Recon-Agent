__pycache__/
*.pyc
.env
venv/
.venv/
# Everything a session writes, whatever the format: v0.7.5 added .json, and a
# per-extension list would have published it on the first `git add -A`.
reports/*
!reports/.gitkeep
.ruff_cache/
.pytest_cache/
config/targets.yaml
# Ignore the contents, keep the folder's README. `state/` alone would stop
# git descending into the directory at all, so the negation below would
# never be reached.
state/*
!state/README.md
